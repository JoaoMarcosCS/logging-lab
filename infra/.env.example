# Variáveis da stack de logs (Elasticsearch, Kibana e Fluent Bit).
# O Makefile copia este arquivo para infra/.env na primeira execução. O infra/.env fica fora do git.
# Senhas com # precisam de aspas: sem elas, o compose pode ler o resto da linha como comentário.

# Senha do superusuário "elastic". Usada só pelo setup e pelo healthcheck.
ELASTIC_PASSWORD="#Demo2026"

# Seu login no Kibana (papel superuser).
KIBANA_USER=teste
KIBANA_USER_PASSWORD="#Demo2026"

# Senha do usuário interno "kibana_system", com que o Kibana se conecta ao Elasticsearch.
KIBANA_SYSTEM_PASSWORD="#Demo2026"

# Senha do usuário "fluent-bit", que só pode gravar nos data streams logs-task-flow-*.
FLUENT_BIT_PASSWORD="#Demo2026"

# Chave que o Kibana usa para cifrar dados salvos (regras de alerta, conectores, sessões).
# Mínimo de 32 caracteres. Se mudar, o Kibana não consegue mais ler o que cifrou antes.
KIBANA_ENCRYPTION_KEY="study-only-kibana-encryption-key-0123456789"

# Portas publicadas no host (sempre em 127.0.0.1).
ELASTICSEARCH_PORT=9200
KIBANA_PORT=5601
FLUENT_BIT_PORT=2020
